{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm format)",
      "Bash(pnpm -r typecheck)",
      "Bash(pnpm -r test)",
      "Bash(pnpm --filter * exec vitest run *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm install *)",
      "Bash(pnpm exec tsx *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pnpm install)",
      "Bash(pnpm i)",
      "Bash(pnpm i *)",
      "Bash(pnpm --filter * add *)",
      "Bash(pnpm --filter * remove *)",
      "Bash(pnpm -F * add *)",
      "Bash(pnpm -F * remove *)",
      "Edit(./package.json)",
      "Edit(./packages/*/package.json)",
      "Edit(./apps/*/package.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./pnpm-workspace.yaml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat .env*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
